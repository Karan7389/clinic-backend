# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/crown-dental
# For MongoDB Atlas use:
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/crown-dental?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── Cloudinary (image uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Frontend origin (for CORS) ────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ── Default admin credentials (used only by `npm run seed`) ──────────────────
ADMIN_EMAIL=admin@crowndental.in
ADMIN_PASSWORD=Admin@123
